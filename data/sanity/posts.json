        "children": [
          {
            "_key": "61c9697b80eb",
            "_type": "span",
            "marks": [],
            "text": "Each component handles a specific part of the interface, helping developers keep their code clean and organized."
          }
        ],
        "markDefs": [],
        "style": "normal"
      },
